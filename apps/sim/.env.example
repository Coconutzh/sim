# Database (Required)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/simstudio"

# Authentication (Required unless DISABLE_AUTH=true)
BETTER_AUTH_SECRET=your_secret_key  # Use `openssl rand -hex 32` to generate, or visit https://www.better-auth.com/docs/installation
BETTER_AUTH_URL=http://localhost:3000

# Authentication Bypass (Optional - for self-hosted deployments behind private networks)
# DISABLE_AUTH=true  # Uncomment to bypass authentication entirely. Creates an anonymous session for all requests.

# NextJS (Required)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# INTERNAL_API_BASE_URL=http://sim-app.default.svc.cluster.local:3000  # Optional: internal URL for server-side /api self-calls; defaults to NEXT_PUBLIC_APP_URL
# TRUSTED_ORIGINS=https://www.example.com,https://app.example.com  # Optional: comma-separated additional public origins to trust for auth (apex+www, alias domains). Merged into Better Auth trustedOrigins.

# Security (Required)
ENCRYPTION_KEY=your_encryption_key  # Use `openssl rand -hex 32` to generate, used to encrypt environment variables
INTERNAL_API_SECRET=your_internal_api_secret # Use `openssl rand -hex 32` to generate, used to encrypt internal api routes
API_ENCRYPTION_KEY=your_api_encryption_key # Use `openssl rand -hex 32` to generate, used to encrypt api keys

# Copilot Backend (Required for the right-side Copilot agent)
# SIM_AGENT_API_URL=https://www.copilot.sim.ai  # Optional override for the remote Copilot backend
# COPILOT_API_KEY=                              # Required key for authenticating Sim -> Copilot backend requests
# COPILOT_STREAM_TTL_SECONDS=3600               # Optional Redis/memory stream retention for Copilot SSE replay
# COPILOT_STREAM_EVENT_LIMIT=5000               # Optional max retained Copilot SSE events per stream
# LOCAL_COPILOT_PROVIDER=deepseek               # Optional local fallback planner provider when the hosted Copilot backend is unavailable
# LOCAL_COPILOT_MODEL=deepseek-chat             # Optional local fallback planner model override
# LOCAL_COPILOT_API_KEY=                        # Optional shared key override for LOCAL_COPILOT_PROVIDER

# Email Provider (Optional)
# RESEND_API_KEY=  # Uncomment and add your key from https://resend.com to send actual emails
                   # If left commented out, emails will be logged to console instead

# Local AI Models (Optional)
# OLLAMA_URL=http://localhost:11434  # URL for local Ollama server - uncomment if using local models
# VLLM_BASE_URL=http://localhost:8000    # Base URL for your self-hosted vLLM (OpenAI-compatible)
# VLLM_API_KEY=                          # Optional bearer token if your vLLM instance requires auth
# FIREWORKS_API_KEY=                     # Optional Fireworks AI API key for model listing
# DEEPSEEK_API_KEY=                      # Optional DeepSeek key used by the local Copilot fallback planner
# OPENAI_API_KEY=                        # Optional OpenAI key used by Image Generator and OpenAI-backed features
# NEXT_PUBLIC_OPENAI_IMAGE_CONFIGURED=true  # Hide the Image Generator API key field when OPENAI_API_KEY is set
# GEMINI_API_KEY=                        # Optional Gemini key used by Veo video generation
# ARK_API_KEY=                           # Optional Volcengine Ark key used by Seedream image generation
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ZHIPU_API_KEY=                         # Optional Zhipu key used by GLM models such as glm-4.7-flash / glm-4.7
# CEREBRAS_API_KEY=                      # Optional Cerebras key used by Cerebras-backed models such as cerebras/zai-glm-4.7
# NEXT_PUBLIC_VEO_CONFIGURED=true        # Hide the Veo API key field when GEMINI_API_KEY is set
# RUNWAY_API_KEY=                        # Optional Runway key used by Video Generator
# NEXT_PUBLIC_RUNWAY_CONFIGURED=true     # Hide the Runway API key field when RUNWAY_API_KEY is set
# LUMA_API_KEY=                          # Optional Luma key used by Video Generator
# NEXT_PUBLIC_LUMA_CONFIGURED=true       # Hide the Luma API key field when LUMA_API_KEY is set
# MINIMAX_API_KEY=                       # Optional MiniMax key used by Video Generator
# NEXT_PUBLIC_MINIMAX_CONFIGURED=true    # Hide the MiniMax API key field when MINIMAX_API_KEY is set
# FAL_API_KEY=                           # Optional Fal.ai key used by Video Generator
# NEXT_PUBLIC_FAL_CONFIGURED=true        # Hide the Fal.ai API key field when FAL_API_KEY is set
# NEXT_PUBLIC_BEDROCK_DEFAULT_CREDENTIALS=true  # Set when using AWS default credential chain (IAM roles, ECS task roles, IRSA). Hides credential fields in Agent block UI.
# AZURE_OPENAI_ENDPOINT=                        # Azure OpenAI endpoint (hides field in UI when set alongside NEXT_PUBLIC_AZURE_CONFIGURED)
# AZURE_OPENAI_API_KEY=                         # Azure OpenAI API key
# AZURE_OPENAI_API_VERSION=                     # Azure OpenAI API version
# AZURE_ANTHROPIC_ENDPOINT=                     # Azure Anthropic endpoint (AI Foundry)
# AZURE_ANTHROPIC_API_KEY=                      # Azure Anthropic API key
# AZURE_ANTHROPIC_API_VERSION=                  # Azure Anthropic API version (e.g., 2023-06-01)
# NEXT_PUBLIC_AZURE_CONFIGURED=true             # Set when Azure credentials are pre-configured above. Hides endpoint/key/version fields in Agent block UI.
# COHERE_API_KEY=                               # Cohere API key for the Knowledge block reranker (rerank-v4.0-pro/-fast, rerank-v3.5). Alternatively set COHERE_API_KEY_1/2/3 for rotation.
# NEXT_PUBLIC_COHERE_CONFIGURED=true            # Set when COHERE_API_KEY (or rotation keys) are pre-configured above. Hides the Cohere API Key field on the Knowledge block UI.

# Admin API (Optional - for self-hosted GitOps)
# ADMIN_API_KEY=  # Use `openssl rand -hex 32` to generate. Enables admin API for workflow export/import.
                  # Usage: curl -H "x-admin-key: your_key" https://your-instance/api/v1/admin/workspaces

# TapNow MVP Tool/Block Pruning (Optional)
# Leave these unset to keep the full product surface. Set the preset below to
# enable the first-pass TapNow-style registry pruning introduced in
# apps/sim/lib/product/tool-policy.ts.
# NEXT_PUBLIC_SIM_TOOL_POLICY_PRESET=tapnow-mvp
# NEXT_PUBLIC_SIM_ENABLED_TOOL_SERVICES=file,mcp,search,slack,gmail,notion
# NEXT_PUBLIC_SIM_ENABLED_TOOL_IDS=http_request,search_tool,file_parser,file_parser_v2,file_parser_v3,file_append,file_write
# NEXT_PUBLIC_SIM_ENABLED_BLOCK_TYPES=agent,api,chat_trigger,condition,file,function,generic_webhook,loop,mcp,note,parallel,response,router,search,start_trigger,variables,webhook_request
